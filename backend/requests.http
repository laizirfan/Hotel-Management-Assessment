POST http://localhost:5000/api/rooms
Content-Type: application/json

{
    "name": "Standard Room",
    "pricePerNight": 2000,
    "capacity": 2,
    "description": "Comfortable standard room",
    "facilities": ["WiFi", "TV"],
    "totalInventory": 10
}

### Register new guest
POST http://localhost:5000/api/auth/register
Content-Type: application/json

{
    "name": "Rahul",
    "email": "rahul@example.com",
    "password": "hello12345"
}

### jwt check
POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
    "email": "rahul@example.com",
    "password": "hello12345"
}

### testing check without token

POST http://localhost:5000/api/rooms
Content-Type: application/json

{
    "name": "Premium Room",
    "pricePerNight": 4500,
    "capacity": 2,
    "description": "Premium room with balcony",
    "facilities": ["WiFi", "AC"],
    "totalInventory": 3
}


#### with token check

POST http://localhost:5000/api/auth/login
Content-Type: application/json

{
    "email": "rahul@example.com",
    "password": "hello12345"
}

### room creat
POST http://localhost:5000/api/rooms
Content-Type: application/json
Authorization: Bearer PASTE_TOKEN_HERE
{
    "name": "Premium Room",
    "pricePerNight": 4500,
    "capacity": 2,
    "description": "Premium room with balcony",
    "facilities": ["WiFi", "AC"],
    "totalInventory": 3
}

